{
  "name": "efn-lower-thirds",
  "version": "0.4.0",
  "private": true,
  "description": "EFN lower thirds as SVG for OGraf: OGraf v1 graphics, browser/Node renderer, slant and corner geometry, design data and assets.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./renderer": {
      "types": "./src/lower-third.d.ts",
      "default": "./src/lower-third.js"
    },
    "./geometry": {
      "types": "./lib/roundedSkewedCardPathUniform.d.ts",
      "default": "./lib/roundedSkewedCardPathUniform.js"
    },
    "./data/*": "./data/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "data",
    "assets",
    "docs",
    "ograf"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build-assets.js && node scripts/build-svgs.js && node scripts/build-ograf.js",
    "check": "node scripts/build-assets.js --check && node scripts/validate-ograf.js && node scripts/check-compat.js",
    "typecheck": "tsc -p tsconfig.json && node scripts/check-exports.js",
    "demo": "node scripts/serve.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
