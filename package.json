{
  "name": "efn-lower-thirds",
  "version": "0.5.0",
  "private": true,
  "description": "EFN broadcast graphics in SVG: OGraf v1 lower thirds, design tokens, plate styles and <efn-plate>, browser/Node renderer, slant and corner geometry, design data and assets.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./renderer": {
      "types": "./src/lower-third.d.ts",
      "default": "./src/lower-third.js"
    },
    "./geometry": {
      "types": "./lib/roundedSkewedCardPathUniform.d.ts",
      "default": "./lib/roundedSkewedCardPathUniform.js"
    },
    "./plate-element": {
      "types": "./src/elements/efn-plate.d.ts",
      "default": "./src/elements/efn-plate.js"
    },
    "./tokens/*": "./tokens/*",
    "./data/*": "./data/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "data",
    "assets",
    "tokens",
    "docs",
    "ograf"
  ],
  "sideEffects": [
    "./src/elements/*.js"
  ],
  "scripts": {
    "build": "node scripts/build-assets.js && node scripts/build-tokens.js && node scripts/build-svgs.js && node scripts/build-ograf.js",
    "check": "node scripts/build-assets.js --check && node scripts/build-tokens.js --check && node scripts/validate-ograf.js && node scripts/check-compat.js",
    "test": "node --test test/snapshots.test.js test/behaviour.test.js",
    "test:update": "node test/snapshots.test.js --update",
    "typecheck": "tsc -p tsconfig.json && node scripts/check-exports.js",
    "demo": "node scripts/serve.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
